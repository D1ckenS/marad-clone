# ─────────────────────────────────────────────────────────────────────────────
# FleetOps — Shore API environment variables
# Copy this file to .env (local dev) or .env.production (server) and fill in
# every value marked <REQUIRED>. Values marked [optional] have safe defaults.
# NEVER commit a file that contains real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
# Local dev (docker-compose.dev.yml spins up Postgres on port 5433):
DATABASE_URL="postgresql://fleetops:fleetops_dev@localhost:5433/fleetops_shore"
# Production example:
# DATABASE_URL="postgresql://fleetops:<STRONG_PASSWORD>@localhost:5433/fleetops_shore"

# ── JWT keypair (RS256) ───────────────────────────────────────────────────────
# Generate once with:  pnpm -w run gen:jwt-keys
# Private key signs tokens — never copy to a vessel.
# Public key is distributed to every vessel for offline verification.
JWT_PRIVATE_KEY_PATH=../../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem

# Token lifetimes in milliseconds.
# H5: default access TTL was reduced from 24h to 15min once refresh-token
# rotation landed — short window contains blast radius if an access token
# leaks. Refresh tokens stay at 30d but are now individually revokable
# (see POST /auth/sessions/:userId/revoke).
JWT_ACCESS_TTL_MS=900000         # 15 min
JWT_REFRESH_TTL_MS=2592000000    # 30 d

# ── SMTP — transactional email (H10) ──────────────────────────────────────────
# Used by MailService for cert-expiry alerts (and future password-reset etc.).
# When SMTP_HOST / SMTP_USER / SMTP_PASS aren't all set the service falls back
# to log-only mode — envelopes are written to the pino log instead of sent.
# That's the safe dev default; production must wire real SMTP or operators
# will silently miss renewal alerts.
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587                  # default 587 (STARTTLS); use 465 for implicit TLS
# SMTP_SECURE=0                  # set to 1 when SMTP_PORT=465
# SMTP_USER=apikey
# SMTP_PASS=<your-smtp-password>
# SMTP_FROM=alerts@fleetops.example.com

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development             # set to "production" on the server

# ── S3-compatible photo storage (MinIO in dev, any S3-compatible in prod) ─────
# docker-compose.dev.yml runs MinIO on port 9000 with these dev credentials.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=fleetops_minio
S3_SECRET_ACCESS_KEY=fleetops_minio_dev
S3_BUCKET=fleetops-photos
S3_FORCE_PATH_STYLE=1            # required for MinIO; set to 0 for AWS S3
S3_REGION=us-east-1

# ── gRPC Sync gateway ─────────────────────────────────────────────────────────
# Set SYNC_ENABLED=1 to start the gRPC server that vessels connect to.
# Leave unset (or set to 0) for local dev when you don't need sync.
SYNC_ENABLED=0
SYNC_GRPC_PORT=50051

# ── gRPC sync TLS (mTLS — B1) ─────────────────────────────────────────────────
# REQUIRED in production: api-shore refuses to boot when NODE_ENV=production
# and any of these three are unset. In dev/test, leave all three unset to run
# the gateway on plaintext loopback.
#
# Generate a dev CA + leaf certs with:
#   pnpm -w run gen:sync-tls
# Then set the three vars to the paths it prints.
#
# Rotation procedure: apps/docs/runbooks/sync-tls-rotation.md
# SYNC_TLS_CA_PATH=../../keys/sync-tls/ca.crt
# SYNC_TLS_CERT_PATH=../../keys/sync-tls/shore.crt
# SYNC_TLS_KEY_PATH=../../keys/sync-tls/shore.key
