# Copy this file to scripts/.env.smoke (gitignored) and fill in real values.
# Used by the smoke-test-*.mjs scripts and apps/desktop-vessel/scripts/seed-demo-db.mjs.
#
# The three accounts below match the users created by seed-demo-db. Smoke tests
# import this set via scripts/_smoke-creds.mjs.

# Super-admin (no tenant)
SMOKE_SUPER_USERNAME=<super-admin-username>
SMOKE_SUPER_EMAIL=<super-admin@example.com>
SMOKE_SUPER_PASSWORD=<super-admin-password>

# Tenant admin — ABM tenant
SMOKE_ABM_USERNAME=<abm-tenant-admin-username>
SMOKE_ABM_EMAIL=<abm-tenant-admin@example.com>
SMOKE_ABM_PASSWORD=<abm-tenant-admin-password>

# Tenant admin — ASM tenant
SMOKE_ASM_USERNAME=<asm-tenant-admin-username>
SMOKE_ASM_EMAIL=<asm-tenant-admin@example.com>
SMOKE_ASM_PASSWORD=<asm-tenant-admin-password>
